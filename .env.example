# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local.

# URL pública del sitio (en Vercel Preview puedes dejar la de localhost)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (proyecto de DESARROLLO). Estos dos son públicos por diseño.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO servidor. Jamás con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anti-bot: Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile) ---
# Para PROBAR en local/preview puedes usar las claves de prueba que Cloudflare documenta:
#   site key: 1x00000000000000000000AA   secret: 1x0000000000000000000000000000000AA
# En PRODUCCIÓN usa claves reales de tu cuenta.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SOLO servidor
TURNSTILE_SECRET_KEY=

# --- Rate limiting: Upstash Redis (https://upstash.com, plan gratuito) ---
# SOLO servidor. Obligatorio en producción (sin esto los pedidos se rechazan por seguridad).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Estadísticas de clics (SOLO servidor) ---
# Necesaria para contar clics de WhatsApp y "Cómo llegar". Sin ella el sitio funciona igual, sin contar.
# SUPABASE_SERVICE_ROLE_KEY ya está más arriba. Ejecuta antes la migración 0006_click_stats.sql.

# --- CSP ---
# Por defecto la política de seguridad de contenido solo AVISA (modo reporte).
# Cuando la consola del navegador no muestre violaciones, cámbiala a true para que bloquee.
CSP_ENFORCE=false
